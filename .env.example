# PROMPTROOM — environment
# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ

# ---------- เว็บแอป ----------
# พอร์ตของเว็บแอป (Express + dist/)
PORT=8787
# 0.0.0.0 = เปิดรับจากภายนอก (ต้องมี reverse proxy/HTTPS), 127.0.0.1 = เครื่องนี้เท่านั้น
HOST=0.0.0.0
NODE_ENV=production

# ---------- ฐานข้อมูล ----------
# โฟลเดอร์เก็บ SQLite และไฟล์ runtime (ต้องเป็น persistent disk บนโฮสต์)
DATA_DIR=./data
# ระบุไฟล์ฐานข้อมูลตรง ๆ ได้ (ไม่ใส่ก็ใช้ DATA_DIR/promptroom.db)
# DB_PATH=./data/promptroom.db

# ---------- Local Control Center (ใช้เฉพาะเครื่อง local) ----------
# Control Center ผูกกับ 127.0.0.1 เสมอ ไม่เปิดสู่อินเทอร์เน็ต
CONTROL_PORT=9090

# พอร์ตที่ Control Center ใช้ตรวจสุขภาพแอป (ปกติเท่ากับ PORT)
APP_PORT=8787

# ---------- Rate limit ----------
# ตั้งเป็น 1 เพื่อปิด rate limit (ไม่แนะนำใน production)
RATE_LIMIT_DISABLED=0

# ---------- AI Boost (ไม่บังคับ) ----------
# ไม่ใส่คีย์ก็ใช้เว็บได้ทุกฟีเจอร์ ยกเว้นปุ่ม AI Boost
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
